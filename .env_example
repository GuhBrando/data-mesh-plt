# Database connection
DB_USER=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_mesh_plt
DB_SSL_MODE=require

# Database role passwords
ADMIN_PASSWORD=
APP_USER_PASSWORD=
USER_PASSWORD=
POSTGRES_PASSWORD=

# Bootstrap admin (used by scripts/seed_admin.py)
PLATFORM_ADMIN_USER=admin@example.com
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASS=

# GitHub integration (data contract repo sync + per-product repos)
# Product repos are created under the owner of GITHUB_REPO.
GITHUB_REPO=GuhBrando/dmplt_data_contract
# Preferred: GitHub App. Used when all three are set; the private key stays in
# Azure Key Vault (locally, `az login` with "Key Vault Crypto User" on the vault).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_KEY_VAULT_KEY_ID=
# Legacy fallback: personal access token, used only when the App is not configured.
GITHUB_TOKEN=
